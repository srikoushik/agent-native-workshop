# Skip the sign-in page while you build: uncomment the line below, and every
# request runs as dev@local.test.
#
# LOCAL DEVELOPMENT ONLY. Nothing stops a deploy with this set — the framework
# prints a "production configuration errors" warning but still builds — so an
# app deployed with it has no authentication at all. Keep it commented here and
# only ever set it in your own untracked .env.
# AUTH_DISABLED=1

# Database (local SQLite by default, set for a remote/cloud database)
# DATABASE_URL=file:./data/app.db
# DATABASE_AUTH_TOKEN=

# Session signing. Required once you turn sign-in back on.
# Generate: openssl rand -hex 32
# BETTER_AUTH_SECRET=

# OAuth state signing — required in production for any OAuth flow you add.
# Falls back to BETTER_AUTH_SECRET when unset.
# OAUTH_STATE_SECRET=

# Deployment preset (see netlify.toml for the Netlify build)
# NITRO_PRESET=netlify
